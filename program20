class Book:
    def __init__(self, book_id, book_name, author):
        self.book_id = book_id
        self.book_name = book_name
        self.author = author
        self.availability = True

    def display_book(self):
        status = "Available" if self.availability else "Issued"
        print(f"ID: {self.book_id} | Title: {self.book_name} | Author: {self.author} | Status: {status}")

    def issue_book(self):
        if not self.availability:
            print(f"Sorry, '{self.book_name}' is already issued.")
        else:
            self.availability = False
            print(f"Successfully issued '{self.book_name}'.")

    def return_book(self):
        if self.availability:
            print(f"'{self.book_name}' is already in the library.")
        else:
            self.availability = True
            print(f"Successfully returned '{self.book_name}'.")


book1 = Book("B101", "The Alchemist", "Paulo Coelho")

book1.display_book()
book1.issue_book()
book1.display_book()
book1.issue_book()
book1.return_book()
book1.display_book()
