class Person:
    def __init__(self, name):
        self.name = name

    def show_name(self):
        print(f"Name: {self.name}")
class Faculty(Person):
    def __init__(self, name, employee_id):
        Person.__init__(self, name)
        self.employee_id = employee_id
    def show_faculty_details(self):
        print(f"Employee ID: {self.employee_id}")
class Student(Person):
    def __init__(self, name, student_id):
        Person.__init__(self, name)
        self.student_id = student_id

    def show_student_details(self):
        print(f"Student ID: {self.student_id}")
class TeachingAssistant(Faculty, Student):
    def __init__(self, name, employee_id, student_id, course):
        Faculty.__init__(self, name, employee_id)
        Student.__init__(self, name, student_id)
        self.course = course
    def show_ta_details(self):
        self.show_name()            
        self.show_faculty_details()   
        self.show_student_details()   
        print(f"Assigned Course: {self.course}")
if __name__ == "__main__":
    ta = TeachingAssistant(name="Alex", employee_id="F908", student_id="S1024", course="Python 101")
    print("--- Teaching Assistant Details ---")
    ta.show_ta_details()
